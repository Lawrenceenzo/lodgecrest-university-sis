PORT=5001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB - local server or an Atlas connection string (include the database name)
MONGO_URI=mongodb://127.0.0.1:27017/student_information_system

# Gmail account that SENDS the login codes. EMAIL_PASS is a Gmail *App Password*
# (16 characters), not your normal Gmail password.
EMAIL_USER=your.address@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop

# If the e-mail cannot be sent (or EMAIL_USER / EMAIL_PASS are blank), print the 6-digit login code in the
# server log so you can still sign in while testing. Hosts such as Render's free tier block outbound SMTP.
# Set to false for real use: anyone who can read the log could otherwise sign in as any user.
# OTP_CONSOLE_FALLBACK=true

# Used only by `npm run seed`. Must be an inbox you can open, because login codes go there.
SEED_ADMIN_EMAIL=your.address@gmail.com
SEED_ADMIN_PASSWORD=admin123

# Optional: demo student login created by the seed (defaults shown)
# SEED_STUDENT_EMAIL=maria.santos@email.com
# SEED_STUDENT_PASSWORD=student123

# Used only by `npm test`. The tests ERASE this database, so it must be a throwaway one whose name
# contains "test" (they refuse anything else). Never point it at your real data.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/lodgecrest_test

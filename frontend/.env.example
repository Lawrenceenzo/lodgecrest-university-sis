# Where the backend API lives. Vite reads this when it BUILDS, so on Vercel set it under
# Project Settings > Environment Variables (Production) and redeploy; changing it later has no effect on an existing build.
# With or without the trailing /api both work.
#
# Local development:
VITE_API_URL=http://localhost:5001/api
# Production (Vercel):
# VITE_API_URL=https://lodgecrest-university-sis.onrender.com/api
